; MahlanyaRPG — Steamworks SDK Integration Config
; Valve requires SteamAPI_Init() called before any Steam API use.
; UE5 handles this via OnlineSubsystemSteam plugin (DefaultEngine.ini entries below).

[SteamworksSDK]
SDKVersion=1.58
SDKPath=Plugins/Online/OnlineSubsystemSteam/Source/ThirdParty/Steamworks/Steam1.58

[UE5OnlineSubsystem]
; These entries belong in Config/DefaultEngine.ini
; [OnlineSubsystem]
; DefaultPlatformService=Steam
; [OnlineSubsystemSteam]
; bEnabled=True
; SteamDevAppId=MAHLANYA_APP_ID
; Achievement_0_Id=ACH_FIRST_CATTLE_RAID
; Achievement_1_Id=ACH_YEAR_1815

[CloudSave]
; UE5 SaveGame objects serialize to Steam Cloud via ISteamRemoteStorage.
; Register save slot names below.
SaveSlot_0=MahlanyaPlayerProfile
SaveSlot_1=MahlanyaWorldState
SaveSlot_2=MahlanyaChronicle
MaxCloudSaveBytes=104857600
